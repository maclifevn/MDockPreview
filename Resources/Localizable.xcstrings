      "localizations" : {
        "vi" : { "stringUnit" : { "state" : "translated", "value" : "Giao diện" } }
      }
    },
    "Applies to the window-preview panel. Changes take effect immediately." : {
      "localizations" : {
        "vi" : { "stringUnit" : { "state" : "translated", "value" : "Áp dụng cho bảng preview cửa sổ. Thay đổi có hiệu lực ngay lập tức." } }
      }
    },
    "Both are needed for previews to work." : {
      "localizations" : {
        "vi" : { "stringUnit" : { "state" : "translated", "value" : "Cả hai đều cần để preview hoạt động." } }
      }
    },
    "Close Window" : {
      "localizations" : {
        "vi" : { "stringUnit" : { "state" : "translated", "value" : "Đóng cửa sổ" } }
      }
