    },
    "If hidden, relaunch the app to reopen Settings" : {
      "localizations" : {
        "vi" : { "stringUnit" : { "state" : "translated", "value" : "Nếu ẩn, hãy khởi chạy lại ứng dụng để mở lại Cài đặt" } }
