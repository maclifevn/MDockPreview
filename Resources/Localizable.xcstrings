      "localizations" : {
        "vi" : { "stringUnit" : { "state" : "translated", "value" : "Quyền cần thiết" } }
      }
    },
    "Show a preview panel when you hover a Dock icon" : {
      "localizations" : {
        "vi" : { "stringUnit" : { "state" : "translated", "value" : "Hiện bảng preview khi rê chuột lên biểu tượng trên Dock" } }
